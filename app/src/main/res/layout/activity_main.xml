<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Material 3 Design - Location Reminders List -->
<androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:fitsSystemWindows="true"
android:background="@drawable/gradient_background">

<!-- Content Container -->
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="vertical"
    android:padding="24dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <!-- Title Section -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Location Reminders"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap + to add a new reminder"
        android:textColor="@color/white"
        android:alpha="0.7"
        android:textSize="14sp"
        android:layout_marginVertical="4dp"/>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/remindersRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"/>
</LinearLayout>

<!-- Google-style FAB in lower right corner -->
<com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/addReminderButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:backgroundTint="@color/colorPrimary"
    app:rippleColor="@color/colorSecondary"
    android:src="@android:drawable/ic_input_add"
    android:contentDescription="Add Reminder"
    app:tint="@color/white"
    app:elevation="6dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_margin="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
