<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:background="@drawable/dialog_gradient_bg"
android:padding="20dp">

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Location Reminder"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"/>

    <!-- Title Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:hintEnabled="false"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="#40000000"
        app:shapeAppearanceOverlay="@style/RoundedCorners">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Reminder Title"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="1"
            android:maxLines="5"
            android:textColor="@color/white"
            android:textColorHint="@color/grey_400"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Location Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Location"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"/>

    <!-- Address Search Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rounded_dark_bg">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:tint="@color/grey_400"
            android:contentDescription="Search icon" />

        <AutoCompleteTextView
            android:id="@+id/inputAddressSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Search for address..."
            android:inputType="textPostalAddress"
            android:imeOptions="actionSearch"
            android:background="@android:color/transparent"
            android:completionThreshold="2"
            android:textColor="@color/white"
            android:textColorHint="@color/grey_400"/>

    </LinearLayout>

    <!-- Map Preview Card - fills remaining space -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mapPreviewCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#40000000">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.gms.maps.MapView
                android:id="@+id/mapPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/mapLoadingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/locationStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Getting location..."
                android:textColor="@color/grey_400"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- Hidden fields -->
    <EditText
        android:id="@+id/inputLocationLat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/inputLocationLng"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Proximity Radius Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proximity Radius"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/rounded_dark_bg"
        android:padding="4dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/radius50"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:tag="50"
            android:text="50m"
            android:textColor="@color/white"
            android:backgroundTint="@android:color/transparent"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/radius100"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:tag="100"
            android:text="100m"
            android:textColor="@color/white"
            android:backgroundTint="@android:color/transparent"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/radius200"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:tag="200"
            android:text="200m"
            android:textColor="@color/white"
            android:backgroundTint="@android:color/transparent"
            android:textSize="14sp"/>

    </LinearLayout>

</LinearLayout>
