<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Material 3 Reminder Item Card with Transparency -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#28000000">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- Location Name (POI or address) -->
    <TextView
        android:id="@+id/reminderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Location Name"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Location icon -->
    <ImageView
        android:id="@+id/locationIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/ic_menu_mylocation"
        android:tint="@color/white"
        android:alpha="0.8"
        app:layout_constraintTop_toTopOf="@id/reminderTitle"
        app:layout_constraintStart_toEndOf="@id/reminderTitle"/>

    <!-- Reminder Text -->
    <TextView
        android:id="@+id/reminderDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Reminder text"
        android:textColor="@color/white"
        android:alpha="0.7"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        app:layout_constraintTop_toBottomOf="@id/reminderTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Reminder Radius -->
    <TextView
        android:id="@+id/reminderRadius"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Within 500m"
        android:textColor="@color/white"
        android:alpha="0.7"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        app:layout_constraintTop_toBottomOf="@id/reminderDescription"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Status indicator (green for active, gray for inactive) -->
    <View
        android:id="@+id/statusIndicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_indicator"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/reminderRadius"
        app:layout_constraintBottom_toBottomOf="@id/reminderRadius"
        app:layout_constraintStart_toEndOf="@id/reminderRadius"/>

    <!-- Triggered notification indicator -->
    <View
        android:id="@+id/triggeredIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/circle_indicator"
        android:backgroundTint="@color/colorPrimary"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/reminderRadius"
        app:layout_constraintBottom_toBottomOf="@id/reminderRadius"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Toggle Status Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/reminderStatusBtn"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="●"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:cornerRadius="8dp"
        app:backgroundTint="#40FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/reminderRadius"
        app:layout_constraintEnd_toEndOf="parent"
        android:focusable="false"
        android:clickable="true"/>

</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
