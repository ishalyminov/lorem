<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Material 3 Reminder Item Card with Transparency -->
<androidx.cardview.widget.CardView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginVertical="8dp"
app:cardCornerRadius="16dp"
app:cardElevation="4dp"
app:cardBackgroundColor="#80000000">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- Reminder Title -->
    <TextView
        android:id="@+id/reminderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sample Reminder Title"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Location icon -->
    <ImageView
        android:id="@+id/locationIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/ic_menu_mylocation"
        android:tint="@color/white"
        android:alpha="0.8"
        app:layout_constraintTop_toTopOf="@id/reminderTitle"
        app:layout_constraintStart_toEndOf="@id/reminderTitle"/>

    <!-- Horizontal Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/white"
        android:alpha="0.3"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/reminderTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Reminder Description -->
    <TextView
        android:id="@+id/reminderDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sample reminder description with optional details..."
        android:textColor="@color/white"
        android:alpha="0.9"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Reminder Radius -->
    <TextView
        android:id="@+id/reminderRadius"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Within 500m"
        android:textColor="@color/white"
        android:alpha="0.7"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/reminderDescription"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Status indicator (green for active, gray for inactive) -->
    <View
        android:id="@+id/statusIndicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_indicator"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/reminderRadius"
        app:layout_constraintBottom_toBottomOf="@id/reminderRadius"
        app:layout_constraintStart_toEndOf="@id/reminderRadius"/>

    <!-- Triggered notification indicator -->
    <View
        android:id="@+id/triggeredIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/circle_indicator"
        android:backgroundTint="@color/colorPrimary"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/reminderRadius"
        app:layout_constraintBottom_toBottomOf="@id/reminderRadius"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Delete Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/reminderDelete"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Delete"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:layout_marginTop="12dp"
        app:cornerRadius="8dp"
        app:backgroundTint="#40FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/reminderRadius"
        app:layout_constraintStart_toStartOf="parent"
        android:focusable="false"
        android:clickable="true"/>

    <!-- Toggle Status Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/reminderStatusBtn"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="●"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp"
        android:visibility="gone"
        app:cornerRadius="8dp"
        app:backgroundTint="#40FFFFFF"
        app:layout_constraintTop_toTopOf="@id/reminderDelete"
        app:layout_constraintBottom_toBottomOf="@id/reminderDelete"
        app:layout_constraintEnd_toEndOf="parent"
        android:focusable="false"
        android:clickable="true"/>

</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
