<?xml version="1.0" encoding="utf-8"?>
<!-- Bright Blurred Gradient Background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Base gradient layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1a237e"
                android:centerColor="#4a148c"
                android:endColor="#880e4f"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Blur overlay - semi-transparent to soften gradient -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
        </shape>
    </item>
    
</layer-list>